	(text_box "SPI_CS1	    GPIO10	18	FSPICS0\nSPI_MOSI	GPIO11	19	FSPID\nSPI_SCK	    GPIO12	20	FSPICLK\nSPI_MISO	GPIO13	21	FSPIQ\n\nUART_TX	    GPIO17	10	U1TXD\nUART_RX	    GPIO18	11	U1RXD\nUART0_TX	GPIO43	37	U0TXD\nUART0_RX	GPIO44	36	U0RXD\n\nJTAG_TDI	GPIO41	34	MTDI\nJTAG_TMS	GPIO42	35	MTMS\n\nADC1	    GPIO1	39	ADC1_CH0\nADC2		GPIO2	38	ADC1_CH1\n\nUSB_D−		GPIO19	13	USB D−\nUSB_D+		GPIO20	14	USB D+\n\n--------------------------------------\n\nSPI_CS2		GPIO9	17	GPIO Matrix\nSPI_DC		GPIO14	22	GPIO Matrix\n\nRGB_DATA	GPIO21	23	Vedľa SPI\n\nDI1_LOGIC	GPIO4	4	Vstup\nDI2_LOGIC	GPIO5	5	Vstup\nDI3_LOGIC	GPIO6	6	Vstup\nDI4_LOGIC	GPIO7	7	Vstup\n\nESP_BOOT	GPIO0	27	BOOT\n\n---------------------------------\n\nDI_AUX1		GPIO15	8\nDO1_CMD		GPIO16	9\nDO2_CMD		GPIO8	12\nDO3_CMD		GPIO47	24\nDO4_CMD		GPIO48	25\n\nI2C_SCL		GPIO38	31\nI2C_SDA		GPIO39	32\n\nDO_FAULT_INT	GPIO40	33"
		(exclude_from_sim no)
